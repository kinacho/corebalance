# Entorno de Almacenamiento
# Si es false, usará IndexedDB (navegador local). Si es true, usará Firebase.
PUBLIC_USE_FIREBASE=true

# Firebase Configuration (Solo si PUBLIC_USE_FIREBASE=true)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Upstash Redis (Recomendado para producción)
# Consigue estos valores en Vercel Dashboard -> Storage -> Upstash
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Resend API Key para envío de emails de soporte (opcional en desarrollo local)
RESEND_API_KEY=your_resend_api_key

